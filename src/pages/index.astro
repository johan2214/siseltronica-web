---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import Services from '../components/Services.astro';
import Catalog from '../components/Catalog.astro';
import FAQ from '../components/FAQ.astro';
import Testimonials from '../components/Testimonials.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { supabase } from '../lib/supabase';
import CategoryCard from '../components/CategoryCard.astro';

const { data: parentCategories } = await supabase
	.from('categories')
	.select('*')
	.is('parent_id', null)
	.order('order_index', { ascending: true });

const sortedCategories = parentCategories || [];
---

<Layout title="Siseltronica | Sistemas Eléctricos y Electrónicos">
  <a href="#main-content" class="skip-link">Saltar al contenido principal</a>
  <Navbar />
  <main id="main-content">
    <Hero />
    <Stats />
    <Services />

    <section id="categorias" class="py-24 relative overflow-hidden">
      <div class="absolute inset-0 bg-linear-to-b from-dark via-surface/10 to-dark"></div>
      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16 fade-in">
          <span class="inline-block px-4 py-1.5 rounded-full border text-sm font-medium mb-4" style="background: rgba(59, 130, 246, 0.15); border-color: rgba(59, 130, 246, 0.3); color: #60a5fa;">Nuestro Catálogo</span>
          <h2 class="text-4xl sm:text-5xl font-black mb-4">Explora por <span class="gradient-text">Categorías</span></h2>
          <p class="text-gray-400 max-w-2xl mx-auto text-lg">Soluciones integrales en seguridad, automatización y electricidad industrial.</p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {sortedCategories.map(cat => (
          	<CategoryCard 
          		id={cat.slug}
          		name={cat.name}
          		description={cat.description || ''}
          		image={cat.image_url || ''}
          	/>
          ))}
        </div>

        <div class="mt-20 text-center fade-in">
          <a 
						href="/productos" 
						class="inline-flex items-center gap-3 px-10 py-4 bg-brand-blue text-white font-bold rounded-2xl transition-all hover:bg-brand-blue/90 hover:scale-105 hover:shadow-2xl hover:shadow-brand-blue/40"
					>
            Ver Todo el Catálogo
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>
        </div>
      </div>
    </section>

    <FAQ />
    <Testimonials />
    <About />
    <Contact />
  </main>
  <Footer />
  <WhatsAppButton />
</Layout>

<style>
	.skip-link {
		position: absolute;
		top: -100px;
		left: 50%;
		transform: translateX(-50%);
		background: var(--color-brand-blue);
		color: white;
		padding: 0.75rem 1.5rem;
		border-radius: 0 0 0.5rem 0.5rem;
		font-weight: 600;
		z-index: 9999;
		transition: top 0.3s ease;
		text-decoration: none;
	}
	.skip-link:focus {
		top: 0;
		outline: 2px solid white;
		outline-offset: 2px;
	}
</style>
<Hero />
<Footer />
