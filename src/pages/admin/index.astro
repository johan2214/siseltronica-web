---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import { supabase } from '../../lib/supabase';

const { count: productsCount } = await supabase.from('products').select('*', { count: 'exact', head: true });
const { count: categoriesCount } = await supabase.from('categories').select('*', { count: 'exact', head: true });
---

<AdminLayout title="Dashboard">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="glass p-8 rounded-3xl border border-white/10">
            <div class="flex items-center justify-between mb-4">
                <div class="w-12 h-12 rounded-2xl bg-brand-blue/10 flex items-center justify-center text-brand-blue">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
                </div>
                <span class="text-xs font-bold text-gray-500 uppercase tracking-widest">Total</span>
            </div>
            <h3 class="text-4xl font-black mb-1">{productsCount || 0}</h3>
            <p class="text-gray-500 text-sm">Productos Activos</p>
        </div>

        <div class="glass p-8 rounded-3xl border border-white/10">
            <div class="flex items-center justify-between mb-4">
                <div class="w-12 h-12 rounded-2xl bg-purple-500/10 flex items-center justify-center text-purple-500">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path></svg>
                </div>
                <span class="text-xs font-bold text-gray-500 uppercase tracking-widest">Organización</span>
            </div>
            <h3 class="text-4xl font-black mb-1">{categoriesCount || 0}</h3>
            <p class="text-gray-500 text-sm">Categorías</p>
        </div>
    </div>

    <div class="mt-12 grid lg:grid-cols-2 gap-8">
        <div class="glass p-8 rounded-3xl border border-white/10">
            <h3 class="text-xl font-bold mb-6">Acciones Rápidas</h3>
            <div class="grid grid-cols-2 gap-4">
                <a href="/admin/productos/nuevo" class="p-4 rounded-2xl bg-white/5 border border-white/5 hover:border-brand-blue/30 transition-all text-center">
                    <span class="block text-2xl mb-2">➕</span>
                    <span class="text-sm font-medium">Nuevo Producto</span>
                </a>
                <a href="/admin/categorias" class="p-4 rounded-2xl bg-white/5 border border-white/5 hover:border-brand-blue/30 transition-all text-center">
                    <span class="block text-2xl mb-2">📁</span>
                    <span class="text-sm font-medium">Nueva Categoría</span>
                </a>
            </div>
        </div>

        <div class="glass p-8 rounded-3xl border border-white/10">
            <h3 class="text-xl font-bold mb-6">Estado del Sistema</h3>
            <div class="flex items-center gap-4 p-4 rounded-2xl bg-green-500/5 border border-green-500/10">
                <div class="w-3 h-3 rounded-full bg-green-500 animate-pulse"></div>
                <span class="text-sm font-medium text-green-500">Supabase: Conectado</span>
            </div>
        </div>
    </div>
</AdminLayout>
