---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Login | Admin Siseltronica">
    <div class="min-h-screen flex items-center justify-center bg-[#050505] p-4">
        <div class="max-w-md w-full glass p-8 rounded-3xl border border-white/10 shadow-2xl">
            <div class="text-center mb-10">
                <div class="w-16 h-16 rounded-2xl bg-brand-blue flex items-center justify-center mx-auto mb-6 shadow-lg shadow-brand-blue/20">
                    <span class="text-2xl font-black text-white">S</span>
                </div>
                <h1 class="text-3xl font-black mb-2">Bienvenido</h1>
                <p class="text-gray-500">Panel de Administración Siseltronica</p>
            </div>

            <form id="login-form" class="space-y-6">
                <div>
                    <label class="block text-sm font-bold text-gray-400 mb-2">Correo Electrónico</label>
                    <input 
                        type="email" 
                        name="email" 
                        required
                        class="w-full bg-white/5 border border-white/10 rounded-2xl px-5 py-4 text-white focus:outline-hidden focus:border-brand-blue/50 transition-all"
                        placeholder="admin@siseltronica.com"
                    />
                </div>
                <div>
                    <label class="block text-sm font-bold text-gray-400 mb-2">Contraseña</label>
                    <input 
                        type="password" 
                        name="password" 
                        required
                        class="w-full bg-white/5 border border-white/10 rounded-2xl px-5 py-4 text-white focus:outline-hidden focus:border-brand-blue/50 transition-all"
                        placeholder="••••••••"
                    />
                </div>

                <div id="error-msg" class="hidden p-4 rounded-xl bg-red-500/10 border border-red-500/20 text-red-400 text-sm text-center">
                </div>

                <button 
                    type="submit"
                    class="w-full py-5 bg-brand-blue hover:bg-brand-blue-light text-white font-black rounded-2xl transition-all hover:scale-[1.02] shadow-xl shadow-brand-blue/20"
                >
                    Entrar al Panel
                </button>
            </form>
        </div>
    </div>
</Layout>

<script>
    import { supabase } from '../../lib/supabase';

    const loginForm = document.getElementById('login-form') as HTMLFormElement;
    const errorMsg = document.getElementById('error-msg');

    // Redirect if already logged in
    const checkSession = async () => {
        const { data: { session } } = await supabase.auth.getSession();
        if (session) {
            window.location.href = '/admin';
        }
    };
    checkSession();

    loginForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const formData = new FormData(loginForm);
        const email = formData.get('email') as string;
        const password = formData.get('password') as string;

        const { error } = await supabase.auth.signInWithPassword({
            email,
            password,
        });

        if (error) {
            if (errorMsg) {
                errorMsg.textContent = "Credenciales inválidas. Intente nuevamente.";
                errorMsg.classList.remove('hidden');
            }
        } else {
            const { data: { session } } = await supabase.auth.getSession();
            if (session) {
                // Set cookies for server-side auth
                document.cookie = `sb-access-token=${session.access_token}; path=/; max-age=${session.expires_in}; SameSite=Lax; Secure`;
                document.cookie = `sb-refresh-token=${session.refresh_token}; path=/; max-age=31536000; SameSite=Lax; Secure`;
            }
            window.location.href = '/admin';
        }
    });
</script>
