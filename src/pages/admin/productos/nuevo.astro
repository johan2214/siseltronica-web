---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { supabase } from '../../../lib/supabase';
import MediaLibrary from '../../../components/admin/MediaLibrary.astro';

const { data: categories } = await supabase
    .from('categories')
    .select('*')
    .not('parent_id', 'is', null)
    .order('name');
---

<AdminLayout title="Nuevo Producto">
    <div class="max-w-4xl mx-auto">
        <form id="product-form" class="space-y-10 pb-20">
            <!-- Header section -->
            <div class="flex items-center justify-between border-b border-white/5 pb-8">
                <div>
                    <h1 class="text-3xl font-black">Crear Producto</h1>
                    <p class="text-gray-500 mt-1">Añade un nuevo ítem al catálogo tecnológico.</p>
                </div>
                <div class="flex gap-4">
                    <a href="/admin/productos" class="px-6 py-3 rounded-xl border border-white/10 text-gray-400 hover:text-white hover:bg-white/5 transition-all font-bold">Cancelar</a>
                    <button type="submit" class="px-8 py-3 bg-brand-blue hover:bg-brand-blue-light text-white font-black rounded-xl transition-all shadow-xl shadow-brand-blue/20">Guardar Producto</button>
                </div>
            </div>

            <div class="grid lg:grid-cols-3 gap-12">
                <!-- Left Column: Main Info -->
                <div class="lg:col-span-2 space-y-8">
                    <div class="glass p-8 rounded-3xl border border-white/10 space-y-6">
                        <h2 class="text-lg font-bold flex items-center gap-2">
                            <span class="w-1.5 h-6 bg-brand-blue rounded-full"></span>
                            Información Básica
                        </h2>
                        
                        <div>
                            <label class="block text-sm font-bold text-gray-400 mb-2">Título del Producto</label>
                            <input type="text" name="title" required class="w-full bg-white/5 border border-white/10 rounded-2xl px-5 py-4 text-white focus:outline-hidden focus:border-brand-blue/50" placeholder="Ej: Cámara Bullet 4K Ultra" />
                        </div>

                        <div>
                            <label class="block text-sm font-bold text-gray-400 mb-2">Slug (URL)</label>
                            <input type="text" name="slug" required class="w-full bg-white/5 border border-white/10 rounded-2xl px-5 py-4 text-white focus:outline-hidden focus:border-brand-blue/50 font-mono" placeholder="ej-camara-bullet-4k" />
                        </div>

                        <div class="grid sm:grid-cols-2 gap-6">
                            <div>
                                <label class="block text-sm font-bold text-gray-400 mb-2">Categoría</label>
                                <select name="category_id" required class="w-full bg-white/5 border border-white/10 rounded-2xl px-5 py-4 text-white focus:outline-hidden focus:border-brand-blue/50">
                                    {categories?.map(cat => (
                                        <option value={cat.id}>{cat.name}</option>
                                    ))}
                                </select>
                            </div>
                            <div>
                                <label class="block text-sm font-bold text-gray-400 mb-2">Estado de Stock</label>
                                <select name="stock_status" class="w-full bg-white/5 border border-white/10 rounded-2xl px-5 py-4 text-white focus:outline-hidden focus:border-brand-blue/50">
                                    <option value="instock">En Stock</option>
                                    <option value="outofstock">Agotado</option>
                                    <option value="onorder">Bajo Pedido</option>
                                </select>
                            </div>
                        </div>

                        <div>
                            <label class="block text-sm font-bold text-gray-400 mb-2">Descripción Corta</label>
                            <textarea name="short_description" rows="2" class="w-full bg-white/5 border border-white/10 rounded-2xl px-5 py-4 text-white focus:outline-hidden focus:border-brand-blue/50" placeholder="Resumen para la tarjeta..."></textarea>
                        </div>

                        <div>
                            <label class="block text-sm font-bold text-gray-400 mb-2">Descripción Completa</label>
                            <textarea name="description" rows="6" class="w-full bg-white/5 border border-white/10 rounded-2xl px-5 py-4 text-white focus:outline-hidden focus:border-brand-blue/50" placeholder="Detalles técnicos, beneficios..."></textarea>
                        </div>
                    </div>

                    <div class="glass p-8 rounded-3xl border border-white/10 space-y-6">
                        <h2 class="text-lg font-bold flex items-center gap-2">
                            <span class="w-1.5 h-6 bg-purple-500 rounded-full"></span>
                            Atributos y Etiquetas
                        </h2>
                        <div class="grid sm:grid-cols-3 gap-6">
                            <label class="flex items-center gap-3 p-4 rounded-2xl bg-white/5 border border-white/5 cursor-pointer hover:border-brand-blue/30 transition-all">
                                <input type="checkbox" name="is_new" class="w-5 h-5 rounded-md border-white/10 bg-white/5 text-brand-blue focus:ring-brand-blue" />
                                <span class="text-sm font-medium">Nuevo</span>
                            </label>
                            <label class="flex items-center gap-3 p-4 rounded-2xl bg-white/5 border border-white/5 cursor-pointer hover:border-brand-blue/30 transition-all">
                                <input type="checkbox" name="is_popular" class="w-5 h-5 rounded-md border-white/10 bg-white/5 text-brand-blue focus:ring-brand-blue" />
                                <span class="text-sm font-medium">Popular</span>
                            </label>
                            <label class="flex items-center gap-3 p-4 rounded-2xl bg-white/5 border border-white/5 cursor-pointer hover:border-brand-blue/30 transition-all">
                                <input type="checkbox" name="is_offer" class="w-5 h-5 rounded-md border-white/10 bg-white/5 text-brand-blue focus:ring-brand-blue" />
                                <span class="text-sm font-medium">Oferta</span>
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Sidebar -->
                <div class="space-y-8">
                    <div class="glass p-8 rounded-3xl border border-white/10 space-y-6">
                        <h2 class="text-lg font-bold">Imagen Principal</h2>
                        <div class="aspect-square rounded-2xl border-2 border-dashed border-white/10 flex flex-col items-center justify-center p-4 relative group overflow-hidden" id="image-preview-container">
                            <div class="text-center" id="upload-placeholder">
                                <svg class="w-10 h-10 text-gray-600 mb-4 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                <span class="text-xs font-bold text-gray-500 uppercase tracking-widest">Subir Imagen</span>
                            </div>
                            <img id="image-preview" class="hidden absolute inset-0 w-full h-full object-cover" />
                            <input type="file" id="image-input" accept="image/*" class="absolute inset-0 opacity-0 cursor-pointer" />
                        </div>
                        <button type="button" id="open-library" class="w-full py-3 rounded-xl border border-white/10 hover:bg-white/5 text-xs font-bold uppercase tracking-widest transition-all">O elegir de la galería</button>
                        <p class="text-[10px] text-gray-500 text-center uppercase tracking-wider">Formatos: JPG, PNG, WEBP. Max 2MB.</p>
                    </div>

                    <div class="glass p-8 rounded-3xl border border-white/10 space-y-6">
                        <h2 class="text-lg font-bold">Ficha Técnica (PDF)</h2>
                        <div class="p-4 rounded-2xl bg-white/5 border border-white/10">
                            <input type="file" id="pdf-input" accept="application/pdf" class="w-full text-xs text-gray-400 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-xs file:font-black file:bg-brand-blue file:text-white hover:file:bg-brand-blue-light cursor-pointer" />
                        </div>
                        <p class="text-[10px] text-gray-500 uppercase tracking-wider text-center">Opcional. Máximo 5MB.</p>
                    </div>
                </div>
            </div>
        </form>
    </div>

    <MediaLibrary />
</AdminLayout>

<script>
    import { supabase } from '../../../lib/supabase';

    const imageInput = document.getElementById('image-input') as HTMLInputElement;
    const pdfInput = document.getElementById('pdf-input') as HTMLInputElement;
    const imagePreview = document.getElementById('image-preview') as HTMLImageElement;
    const uploadPlaceholder = document.getElementById('upload-placeholder');
    const form = document.getElementById('product-form') as HTMLFormElement;
    const openLibraryBtn = document.getElementById('open-library');

    let selectedFile: File | null = null;
    let selectedPdf: File | null = null;
    let currentImageUrl = '';

    // Open Library
    openLibraryBtn?.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('open-media-library'));
    });

    // Handle selection from library
    window.addEventListener('media-selected', (e: any) => {
        const { url } = e.detail;
        console.log('Media selected from library:', url);
        currentImageUrl = url;
        if (imagePreview) {
            imagePreview.src = url;
            imagePreview.classList.remove('hidden');
            uploadPlaceholder?.classList.add('hidden');
            selectedFile = null; // Clear local file if choosing from library
        }
    });

    imageInput?.addEventListener('change', (e) => {
        const file = (e.target as HTMLInputElement).files?.[0];
        if (file) {
            selectedFile = file;
            currentImageUrl = ''; // Clear selected URL if choosing a new file
            const reader = new FileReader();
            reader.onload = (e) => {
                if (imagePreview && e.target) {
                    imagePreview.src = e.target.result as string;
                    imagePreview.classList.remove('hidden');
                    uploadPlaceholder?.classList.add('hidden');
                }
            };
            reader.readAsDataURL(file);
        }
    });

    pdfInput?.addEventListener('change', (e) => {
        const file = (e.target as HTMLInputElement).files?.[0];
        if (file) selectedPdf = file;
    });

    form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
        submitBtn.disabled = true;
        submitBtn.textContent = "Guardando...";

        const formData = new FormData(form);
        let finalImageUrl = currentImageUrl;
        let pdfUrl = '';

        try {
            // 1. Upload Image if new file selected
            if (selectedFile) {
                const fileName = `${Date.now()}-${selectedFile.name.replace(/\s+/g, '_')}`;
                const { error: uploadError } = await supabase.storage
                    .from('catalog')
                    .upload(fileName, selectedFile);

                if (uploadError) throw new Error("Error subiendo imagen: " + uploadError.message);

                const { data: { publicUrl } } = supabase.storage.from('catalog').getPublicUrl(fileName);
                finalImageUrl = publicUrl;
            }

            if (!finalImageUrl) throw new Error("Debes seleccionar una imagen");

            // 2. Upload PDF if selected
            if (selectedPdf) {
                const fileName = `pdf-${Date.now()}-${selectedPdf.name.replace(/\s+/g, '_')}`;
                const { error: uploadError } = await supabase.storage
                    .from('catalog')
                    .upload(fileName, selectedPdf);

                if (uploadError) throw new Error("Error subiendo PDF: " + uploadError.message);

                const { data: { publicUrl } } = supabase.storage.from('catalog').getPublicUrl(fileName);
                pdfUrl = publicUrl;
            }

            // 3. Insert Product
            const productData = {
                title: formData.get('title'),
                slug: formData.get('slug'),
                short_description: formData.get('short_description'),
                description: formData.get('description'),
                category_id: formData.get('category_id'),
                stock_status: formData.get('stock_status'),
                is_new: formData.get('is_new') === 'on',
                is_popular: formData.get('is_popular') === 'on',
                is_offer: formData.get('is_offer') === 'on',
                image_url: finalImageUrl,
                pdf_url: pdfUrl,
            };

            const { error: insertError } = await supabase
                .from('products')
                .insert([productData]);

            if (insertError) throw insertError;

            window.location.href = '/admin/productos';
        } catch (error: any) {
            alert(error.message);
            submitBtn.disabled = false;
            submitBtn.textContent = "Guardar Producto";
        }
    });
</script>
