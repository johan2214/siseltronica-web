---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { supabase } from '../../../lib/supabase';

const { data: products } = await supabase
    .from('products')
    .select('*, category:categories(name)')
    .order('created_at', { ascending: false });
---

<AdminLayout title="Gestionar Productos">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6 mb-10">
        <div>
            <h1 class="text-3xl font-black">Productos</h1>
            <p class="text-gray-500 text-sm mt-1">Gestiona el inventario de Siseltronica</p>
        </div>
        
        <div class="flex flex-col sm:flex-row gap-4 w-full md:w-auto">
            <div class="relative group">
                <svg class="w-5 h-5 absolute left-4 top-1/2 -translate-y-1/2 text-gray-500 group-focus-within:text-brand-blue transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                <input 
                    type="text" 
                    id="search-products"
                    placeholder="Buscar por nombre o slug..." 
                    class="bg-white/5 border border-white/10 rounded-xl pl-12 pr-6 py-3 text-sm focus:outline-hidden focus:border-brand-blue/50 w-full sm:w-64 transition-all"
                />
            </div>
            <a 
                href="/admin/productos/nuevo" 
                class="px-6 py-3 bg-brand-blue hover:bg-brand-blue-light text-white font-bold rounded-xl transition-all shadow-lg shadow-brand-blue/20 flex items-center justify-center gap-2"
            >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                Nuevo Producto
            </a>
        </div>
    </div>

    <div class="glass rounded-3xl border border-white/10 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead>
                    <tr class="bg-white/5 text-gray-400 text-xs font-bold uppercase tracking-widest">
                        <th class="px-8 py-4">Producto</th>
                        <th class="px-8 py-4">Categoría</th>
                        <th class="px-8 py-4">Estado</th>
                        <th class="px-8 py-4 text-right">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-white/5" id="products-table-body">
                    {products?.map(product => (
                        <tr class="hover:bg-white/[0.02] transition-colors product-row" data-search={`${product.title} ${product.slug}`.toLowerCase()}>
                            <td class="px-8 py-6">
                                <div class="flex items-center gap-4">
                                    <div class="w-12 h-12 rounded-lg overflow-hidden bg-white/5 flex-shrink-0 border border-white/10">
                                        {product.image_url ? (
                                            <img src={product.image_url} alt="" class="w-full h-full object-cover" />
                                        ) : (
                                            <div class="w-full h-full flex items-center justify-center text-gray-600 text-xs">NO IMG</div>
                                        )}
                                    </div>
                                    <div>
                                        <div class="font-bold text-white mb-0.5">{product.title}</div>
                                        <div class="text-xs text-gray-500 font-mono uppercase">{product.slug}</div>
                                    </div>
                                </div>
                            </td>
                            <td class="px-8 py-6">
                                <span class="text-sm text-gray-400">{product.category?.name || 'Sin Categoría'}</span>
                            </td>
                            <td class="px-8 py-6">
                                <span class={`inline-flex px-2 py-1 rounded-md text-[10px] font-black uppercase tracking-tighter ${
                                    product.stock_status === 'instock' ? 'bg-green-500/10 text-green-500' : 'bg-red-500/10 text-red-500'
                                }`}>
                                    {product.stock_status === 'instock' ? 'En Stock' : 'Agotado'}
                                </span>
                            </td>
                            <td class="px-8 py-6 text-right">
                                <div class="flex items-center justify-end gap-3">
                                    <a href={`/admin/productos/editar?id=${product.id}`} class="p-2 rounded-lg bg-white/5 hover:bg-white/10 text-gray-400 hover:text-white transition-all">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-5M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
                                    </a>
                                    <button 
                                        class="p-2 rounded-lg bg-white/5 hover:bg-red-500/10 text-gray-400 hover:text-red-500 transition-all delete-btn"
                                        data-id={product.id}
                                        data-title={product.title}
                                    >
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    ))}
                </tbody>
            </table>
        </div>
    </div>
</AdminLayout>

<script>
    import { supabase } from '../../../lib/supabase';

    // Search Logic
    const searchInput = document.getElementById('search-products') as HTMLInputElement;
    const productRows = document.querySelectorAll('.product-row');

    searchInput?.addEventListener('input', (e) => {
        const query = (e.target as HTMLInputElement).value.toLowerCase();
        productRows.forEach(row => {
            const searchText = (row as HTMLElement).dataset.search || '';
            if (searchText.includes(query)) {
                (row as HTMLElement).style.display = '';
            } else {
                (row as HTMLElement).style.display = 'none';
            }
        });
    });

    // Delete Logic
    const deleteBtns = document.querySelectorAll('.delete-btn');

    deleteBtns.forEach(btn => {
        btn.addEventListener('click', async () => {
            const id = (btn as HTMLElement).dataset.id;
            const title = (btn as HTMLElement).dataset.title;

            if (confirm(`¿Está seguro que desea eliminar "${title}"?`)) {
                const { error } = await supabase
                    .from('products')
                    .delete()
                    .eq('id', id);

                if (error) alert("Error al eliminar: " + error.message);
                else window.location.reload();
            }
        });
    });
</script>
