---
export const prerender = false;
import { supabase } from '../../lib/supabase';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import ProductCard from '../../components/ProductCard.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';

const { slug } = Astro.params;

// Get the parent category
const { data: category } = await supabase
    .from('categories')
    .select('*')
    .eq('slug', slug)
    .single();

if (!category) return Astro.redirect('/404');

// Get child categories for sidebar
const { data: subCategoriesData } = await supabase
    .from('categories')
    .select('*')
    .eq('parent_id', category.id)
    .order('order_index', { ascending: true });

const subCategories = subCategoriesData || [];
const subIds = subCategories.map(s => s.id);

// Get products for this parent category or its children
const allCategoryIds = [category.id, ...subCategories.map(s => s.id)];
const { data: productsData } = await supabase
    .from('products')
    .select('*, category:categories(*)')
    .in('category_id', allCategoryIds)
    .order('title');

const products = productsData || [];
const title = `${category.name} | Siseltronica`;
---

<Layout title={title}>
    <Navbar />
    <main class="pt-32 pb-24 min-h-screen">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <!-- Breadcrumbs -->
            <nav class="flex mb-8 text-sm text-gray-400" aria-label="Breadcrumb">
                <ol class="flex items-center space-x-2">
                    <li><a href="/" class="hover:text-brand-blue-light transition-colors">Inicio</a></li>
                    <li class="flex items-center space-x-2">
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path></svg>
                        <span class="text-white font-medium">{category.name}</span>
                    </li>
                </ol>
            </nav>

            <header class="mb-12">
                <h1 class="text-4xl sm:text-6xl font-black mb-6">{category.name}</h1>
                <p class="text-gray-400 text-lg max-w-3xl">{category.description}</p>
            </header>

            <div class="flex flex-col lg:flex-row gap-12">
                <!-- Sidebar / Filters -->
                <aside class="lg:w-64 shrink-0">
                    <div class="sticky top-32 glass p-5 rounded-2xl border border-white/10">
                        <!-- Search Bar -->
                        <div class="mb-6">
                            <div class="relative">
                                <input 
                                    type="text" 
                                    id="productSearch"
                                    placeholder="Buscar productos..." 
                                    class="w-full bg-white/5 border border-white/10 rounded-xl py-2.5 pl-10 pr-4 text-sm focus:outline-hidden focus:border-brand-blue/50 transition-all"
                                />
                                <svg class="w-4 h-4 text-gray-500 absolute left-3.5 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                            </div>
                        </div>

                        <h2 class="text-sm font-bold text-gray-500 uppercase tracking-widest mb-4 flex items-center gap-2">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path></svg>
                            Filtrar
                        </h2>
                        <div class="flex flex-col gap-1.5">
                            <button 
                                class="filter-btn group w-full text-left px-4 py-2.5 rounded-xl border border-transparent bg-white/5 active transition-all duration-300"
                                data-filter="todos"
                            >
                                <div class="flex items-center justify-between">
                                    <span class="text-sm font-medium">Todos</span>
                                    <div class="w-1.5 h-1.5 rounded-full bg-brand-blue opacity-0 group-[.active]:opacity-100 transition-opacity"></div>
                                </div>
                            </button>
                            {subCategories.map(sub => (
                                <button 
                                    class="filter-btn group w-full text-left px-4 py-2.5 rounded-xl border border-transparent text-gray-400 transition-all duration-300 hover:bg-white/5 hover:text-white"
                                    data-filter={sub.slug}
                                >
                                    <div class="flex items-center justify-between">
                                        <span class="text-sm font-medium">{sub.name}</span>
                                        <div class="w-1.5 h-1.5 rounded-full bg-brand-blue opacity-0 group-[.active]:opacity-100 transition-opacity"></div>
                                    </div>
                                </button>
                            ))}
                        </div>
                        
                        <div class="mt-6 pt-6 border-t border-white/5">
                            <a href={`https://wa.me/4140779060`} target="_blank" class="flex items-center justify-center gap-2 py-3 rounded-xl bg-green-600/10 text-green-500 text-xs font-bold hover:bg-green-600/20 transition-all">
                                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"></path></svg>
                                Consultar Asesor
                            </a>
                        </div>
                    </div>
                </aside>

                <!-- Product Grid -->
                <div class="flex-1">
                    <div id="productGrid" class="grid sm:grid-cols-2 xl:grid-cols-3 gap-6">
                        {products.map(product => (
                            <ProductCard 
                                id={product.slug}
                                title={product.title}
                                shortDescription={product.short_description}
                                description={product.description}
                                category={product.category.slug}
                                isNew={product.is_new}
                                isPopular={product.is_popular}
                                isOffer={product.is_offer}
                                isWiFi={product.is_wifi}
                                iconColor={product.icon_color || 'blue'}
                                image={product.image_url}
                            >
                                <div slot="icon" class="h-28 w-28 flex items-center justify-center">
                                    <!-- Legacy icons can go here if needed -->
                                </div>
                            </ProductCard>
                        ))}
                    </div>

                    <!-- No results message -->
                    <div id="noResults" class="hidden text-center py-24">
                        <div class="w-20 h-20 bg-surface rounded-full flex items-center justify-center mx-auto mb-6 border border-white/10">
                            <svg class="w-10 h-10 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                        </div>
                        <p class="text-gray-400 text-xl font-medium">No se encontraron productos en esta subcategoría.</p>
                        <button class="mt-4 text-brand-blue font-bold hover:underline" id="resetFilters">Mostrar todos</button>
                    </div>
                </div>
            </div>
        </div>
    </main>
    <Footer />
    <WhatsAppButton />
</Layout>

<style>
    .filter-btn.active {
        border-color: var(--color-brand-blue-light);
        background: rgba(59, 130, 246, 0.2);
        color: white;
    }
    .hidden-card { display: none; }
</style>

<script>
    const filterBtns = document.querySelectorAll('.filter-btn');
    const productCards = document.querySelectorAll('.product-card');
    const noResults = document.getElementById('noResults');
    const productSearch = document.getElementById('productSearch') as HTMLInputElement;
    
    let currentFilter = 'todos';
    let currentSearch = '';

    const normalize = (str: string) => 
        str.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase();

    function updateVisibility() {
        let visibleCount = 0;
        const normalizedSearch = normalize(currentSearch);
        
        productCards.forEach(card => {
            const category = (card as HTMLElement).dataset.category;
            const title = normalize(card.querySelector('h3')?.textContent || '');
            const description = normalize(card.querySelector('p')?.textContent || '');
            
            const matchesFilter = currentFilter === 'todos' || category === currentFilter;
            const matchesSearch = title.includes(normalizedSearch) || description.includes(normalizedSearch);
            
            if (matchesFilter && matchesSearch) {
                (card as HTMLElement).style.display = 'flex';
                visibleCount++;
            } else {
                (card as HTMLElement).style.display = 'none';
            }
        });

        if (noResults) {
            if (visibleCount === 0) noResults.classList.remove('hidden');
            else noResults.classList.add('hidden');
        }
    }

    filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            filterBtns.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            currentFilter = (btn as HTMLElement).dataset.filter || 'todos';
            updateVisibility();
        });
    });

    productSearch?.addEventListener('input', (e) => {
        currentSearch = (e.target as HTMLInputElement).value.toLowerCase();
        updateVisibility();
    });
</script>
