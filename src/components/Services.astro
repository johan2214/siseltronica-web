---
const services = [
    {
        title: "Cámaras de Vigilancia",
        description: "Instalación de cámaras HD y 4K para interiores y exteriores con visión nocturna y acceso remoto.",
        icon: "video",
        color: "blue"
    },
    {
        title: "Circuito Cerrado (CCTV)",
        description: "Sistemas completos de circuito cerrado con grabación, monitoreo en tiempo real y alertas inteligentes.",
        icon: "shield",
        color: "blue"
    },
    {
        title: "Portones Eléctricos",
        description: "Automatización de portones con motores de alta potencia, controles remotos y sistemas de seguridad.",
        icon: "lock",
        color: "red"
    },
    {
        title: "Sistemas Eléctricos",
        description: "Diseño, instalación y mantenimiento de instalaciones eléctricas residenciales e industriales.",
        icon: "bolt",
        color: "blue"
    },
    {
        title: "Venta de Equipos",
        description: "Amplio catálogo de equipos eléctricos y electrónicos de las mejores marcas del mercado.",
        icon: "cart",
        color: "red"
    },
    {
        title: "Intercomunicadores",
        description: "Sistemas de intercomunicación con video para edificios residenciales y comerciales.",
        icon: "settings",
        color: "blue"
    }
];
---

<section id="servicios" class="py-24 relative">
    <!-- Background elements -->
    <div class="absolute top-0 right-0 w-[400px] h-[400px] bg-brand-blue/3 rounded-full blur-[150px]"></div>
    
    <div class="absolute inset-0 bg-linear-to-b from-dark via-surface/20 to-dark text-white"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16 fade-in">
            <span class="inline-block px-4 py-1.5 rounded-full border text-sm font-medium mb-4 animate-pulse" style="background: rgba(59, 130, 246, 0.15); border-color: rgba(59, 130, 246, 0.3); color: #60a5fa;">Nuestros Servicios</span>
            <h2 class="text-4xl sm:text-5xl font-black mb-4">Lo que <span class="gradient-text">hacemos</span></h2>
            <p class="text-gray-400 max-w-2xl mx-auto text-lg">Ofrecemos soluciones integrales en sistemas eléctricos y electrónicos para hogares y empresas.</p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
            {services.map((service, index) => (
                <div class="group p-8 rounded-2xl glass card-hover fade-in relative overflow-hidden" style={`animation-delay: ${index * 100}ms`}>
                    <!-- Glow effect on hover -->
                    <div class={`absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 ${service.color === 'blue' ? 'bg-gradient-to-br from-brand-blue/10 to-transparent' : 'bg-gradient-to-br from-brand-red/10 to-transparent'}`}></div>
                    
                    <div class={`w-14 h-14 rounded-xl flex items-center justify-center mb-6 ${service.color === 'blue' ? 'bg-brand-blue/15' : 'bg-brand-red/15'}`}>
                        {service.icon === 'video' && <svg class={`w-7 h-7 ${service.color === 'blue' ? 'text-blue-400' : 'text-brand-red'}`} fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>}
                        {service.icon === 'shield' && <svg class={`w-7 h-7 ${service.color === 'blue' ? 'text-blue-400' : 'text-brand-red'}`} fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>}
                        {service.icon === 'lock' && <svg class={`w-7 h-7 ${service.color === 'blue' ? 'text-blue-400' : 'text-red-400'}`} fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>}
                        {service.icon === 'bolt' && <svg class={`w-7 h-7 ${service.color === 'blue' ? 'text-blue-400' : 'text-brand-red'}`} fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>}
                        {service.icon === 'cart' && <svg class={`w-7 h-7 ${service.color === 'blue' ? 'text-blue-400' : 'text-red-400'}`} fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z"></path></svg>}
                        {service.icon === 'settings' && <svg class={`w-7 h-7 ${service.color === 'blue' ? 'text-blue-400' : 'text-brand-red'}`} fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>}
                    </div>
                    <h3 class="text-xl font-bold mb-3 relative z-10">{service.title}</h3>
                    <p class="text-gray-400 leading-relaxed relative z-10">{service.description}</p>
                </div>
            ))}
        </div>
        <div class="line-glow mt-16"></div>
    </div>
</section>
