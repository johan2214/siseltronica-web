---
import { supabase } from '../lib/supabase';
import ProductCard from './ProductCard.astro';

interface Props {
    limit?: number;
    showFilters?: boolean;
}

const { limit, showFilters = true } = Astro.props;

// Fetch products with their category
const { data: allProductsData } = await supabase
    .from('products')
    .select('*, category:categories!inner(*)');

const allProducts = allProductsData || [];

// Fetch child categories for filters (subcategories)
const { data: categoriesData } = await supabase
    .from('categories')
    .select('*')
    .not('parent_id', 'is', null)
    .order('order_index', { ascending: true });

const dbCategories = (categoriesData || []).map(cat => ({
    id: cat.slug,
    name: cat.name,
    slug: cat.slug
}));

const categories = [
    { id: 'todos', name: 'Todos', slug: 'todos' },
    ...dbCategories
];

const products = limit ? allProducts.slice(0, limit) : allProducts;
---
<section id="catalogo" class="py-24 relative overflow-hidden">
    <div class="absolute inset-0 bg-linear-to-b from-dark via-surface/10 to-dark"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16 fade-in">
            <span class="inline-block px-4 py-1.5 rounded-full border text-sm font-medium mb-4" style="background: rgba(59, 130, 246, 0.15); border-color: rgba(59, 130, 246, 0.3); color: #60a5fa;">Catálogo Completo</span>
            <h2 class="text-4xl sm:text-5xl font-black mb-4">Nuestros <span class="gradient-text">Productos</span></h2>
            <p class="text-gray-400 max-w-2xl mx-auto text-lg">Explora nuestra selección completa de equipos electrónicos y eléctricos.</p>
        </div>

        <div class="flex flex-col lg:flex-row gap-12">
            {showFilters && (
                <!-- Sidebar / Filters -->
                <aside class="lg:w-64 shrink-0 fade-in">
                    <div class="sticky top-32 glass p-6 rounded-3xl border border-white/10 shadow-2xl">
                        <!-- Search Bar -->
                        <div class="mb-8">
                            <label for="productSearch" class="block text-xs font-bold text-gray-500 uppercase tracking-widest mb-3 ml-1">Buscar</label>
                            <div class="relative">
                                <input 
                                    type="text" 
                                    id="productSearch"
                                    placeholder="¿Qué buscas?" 
                                    class="w-full bg-white/5 border border-white/10 rounded-2xl py-3.5 pl-12 pr-4 text-sm text-white focus:outline-hidden focus:border-brand-blue/50 focus:ring-1 focus:ring-brand-blue/20 transition-all placeholder:text-gray-600"
                                />
                                <svg class="w-5 h-5 text-gray-500 absolute left-4 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                            </div>
                        </div>

                        <h2 class="text-xs font-bold text-gray-500 uppercase tracking-widest mb-4 flex items-center gap-2 ml-1">
                            <svg class="w-4 h-4 text-brand-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path></svg>
                            Categorías
                        </h2>
                        <div class="flex flex-col gap-1.5 pr-2">
                            {categories.map((cat) => (
                                <button 
                                    class={`filter-btn group w-full text-left px-5 py-3 rounded-2xl border border-transparent transition-all duration-300 ${cat.id === 'todos' ? 'active bg-brand-blue/10 text-white' : 'text-gray-400 hover:bg-white/5 hover:text-white'}`}
                                    data-filter={cat.slug}
                                >
                                    <div class="flex items-center justify-between">
                                        <span class="text-sm font-medium">{cat.name}</span>
                                        <div class="w-1.5 h-1.5 rounded-full bg-brand-blue opacity-0 group-[.active]:opacity-100 shadow-[0_0_8px_rgba(59,130,246,0.8)] transition-opacity"></div>
                                    </div>
                                </button>
                            ))}
                        </div>
                        
                        <div class="mt-8 pt-6 border-t border-white/5">
                            <a href="https://wa.me/573000000000" target="_blank" class="flex items-center justify-center gap-3 py-4 rounded-2xl bg-green-600/10 text-green-500 text-xs font-black hover:bg-green-600/20 transition-all uppercase tracking-widest">
                                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"></path></svg>
                                Consultar Asesor
                            </a>
                        </div>
                    </div>
                </aside>
            )}

            <!-- Product Grid -->
            <div class="flex-1">
                <div id="productGrid" class="grid sm:grid-cols-2 xl:grid-cols-3 gap-6 fade-in">
                    {products.map((product) => (
                        <ProductCard 
                            id={product.slug}
                            title={product.title}
                            shortDescription={product.short_description}
                            description={product.description}
                            category={product.category.slug}
                            isNew={product.is_new}
                            isPopular={product.is_popular}
                            isOffer={product.is_offer}
                            isWiFi={product.is_wifi}
                            iconColor={product.icon_color || 'blue'}
                            image={product.image_url}
                        />
                    ))}
                </div>

                <!-- No results message -->
                <div id="noResults" class="hidden text-center py-24 border-2 border-dashed border-white/5 rounded-[3rem] fade-in">
                    <div class="w-24 h-24 bg-brand-blue/5 rounded-full flex items-center justify-center mx-auto mb-8 border border-brand-blue/10">
                        <svg class="w-10 h-10 text-brand-blue/50" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                    </div>
                    <h3 class="text-2xl font-bold mb-2">No encontramos resultados</h3>
                    <p class="text-gray-500 max-w-sm mx-auto mb-8">Intenta ajustar tus filtros o buscar términos más generales.</p>
                    <button id="reset-filters" class="px-8 py-3 bg-white/5 hover:bg-white/10 border border-white/10 rounded-2xl font-bold transition-all">Limpiar filtros</button>
                </div>

                {limit && allProducts.length > limit && (
                    <div class="mt-16 text-center">
                        <a 
                            href="/productos" 
                            class="inline-flex items-center gap-3 px-10 py-4 bg-surface border border-brand-blue/30 text-white font-bold rounded-2xl transition-all hover:bg-brand-blue/10 hover:shadow-2xl hover:shadow-brand-blue/20"
                        >
                            Ver Todo el Catálogo
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                        </a>
                    </div>
                )}
            </div>
        </div>

        <div class="line-glow mt-24"></div>
    </div>
</section>

<style>
    .filter-btn.active {
        border-color: rgba(59, 130, 246, 0.3);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2), inset 0 0 0 1px rgba(59, 130, 246, 0.1);
    }
    
    .hidden-card {
        display: none !important;
    }
    
    .visible-card {
        display: flex !important;
        animation: card-appear 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @keyframes card-appear {
        from { opacity: 0; transform: translateY(10px) scale(0.98); }
        to { opacity: 1; transform: translateY(0) scale(1); }
    }
</style>

<script>
    function setupFilters() {
        const filterBtns = document.querySelectorAll('.filter-btn');
        const productCards = document.querySelectorAll('.product-card');
        const noResults = document.getElementById('noResults');
        const productSearch = document.getElementById('productSearch') as HTMLInputElement;
        const resetBtn = document.getElementById('reset-filters');

        let currentFilter = 'todos';
        let currentSearch = '';

        const normalize = (str: string) => 
            str.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase();

        function updateVisibility() {
            let visibleCount = 0;
            const normalizedSearch = normalize(currentSearch);
            
            productCards.forEach(card => {
                const category = (card as HTMLElement).dataset.category;
                const title = normalize(card.querySelector('h3')?.textContent || '');
                const description = normalize(card.querySelector('p')?.textContent || '');
                
                const matchesFilter = currentFilter === 'todos' || category === currentFilter;
                const matchesSearch = title.includes(normalizedSearch) || description.includes(normalizedSearch);
                
                if (matchesFilter && matchesSearch) {
                    card.classList.remove('hidden-card');
                    card.classList.add('visible-card');
                    visibleCount++;
                } else {
                    card.classList.remove('visible-card');
                    card.classList.add('hidden-card');
                }
            });

            if (noResults) {
                if (visibleCount === 0) noResults.classList.remove('hidden');
                else noResults.classList.add('hidden');
            }
        }

        filterBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                filterBtns.forEach(b => {
                    b.classList.remove('active', 'bg-brand-blue/10', 'text-white');
                    b.classList.add('text-gray-400');
                });
                btn.classList.add('active', 'bg-brand-blue/10', 'text-white');
                btn.classList.remove('text-gray-400');
                
                currentFilter = (btn as HTMLElement).dataset.filter || 'todos';
                updateVisibility();
            });
        });

        productSearch?.addEventListener('input', (e) => {
            currentSearch = (e.target as HTMLInputElement).value.toLowerCase();
            updateVisibility();
        });

        resetBtn?.addEventListener('click', () => {
            if (productSearch) productSearch.value = '';
            currentSearch = '';
            
            // Click the 'todos' button
            const todosBtn = document.querySelector('.filter-btn[data-filter="todos"]') as HTMLButtonElement;
            todosBtn?.click();
        });
    }

    // Run setup on load and on view transition
    setupFilters();
    document.addEventListener('astro:after-swap', setupFilters);
</script>
