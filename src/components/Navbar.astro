<!-- Mobile Menu -->
<div
    id="mobileMenu"
    class="mobile-menu fixed top-0 right-0 h-full w-72 bg-surface z-60 p-6 md:hidden"
    role="dialog"
    aria-modal="true"
    aria-label="Menú de navegación"
>
    <button
        id="closeMenu"
        class="absolute top-6 right-6 p-2 rounded-lg hover:bg-surfaceLight transition-colors"
        aria-label="Cerrar menú"
    >
        <svg
            class="w-6 h-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"></path></svg
        >
    </button>
    <div class="mt-16 flex flex-col gap-6">
        <a
            href="/#inicio"
            class="text-lg font-medium text-gray-300 hover:text-white transition-colors mobile-link"
            >Inicio</a
        >
        <a
            href="/#servicios"
            class="text-lg font-medium text-gray-300 hover:text-white transition-colors mobile-link"
            >Servicios</a
        >
        <a
            href="/#catalogo"
            class="text-lg font-medium text-gray-300 hover:text-white transition-colors mobile-link"
            >Catálogo</a
        >
        <a
            href="/#testimonios"
            class="text-lg font-medium text-gray-300 hover:text-white transition-colors mobile-link"
            >Testimonios</a
        >
        <a
            href="/#faq"
            class="text-lg font-medium text-gray-300 hover:text-white transition-colors mobile-link"
            >Preguntas</a
        >
        <a
            href="/#nosotros"
            class="text-lg font-medium text-gray-300 hover:text-white transition-colors mobile-link"
            >Nosotros</a
        >
        <a
            href="/#contacto"
            class="text-lg font-medium text-gray-300 hover:text-white transition-colors mobile-link"
            >Contacto</a
        >
        <a
            href="https://wa.me/4140779060"
            target="_blank"
            class="mt-4 px-5 py-3 bg-green-600 hover:bg-green-500 text-white text-sm font-semibold rounded-lg transition-all text-center flex items-center justify-center gap-2"
        >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"
                ><path
                    d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
                ></path></svg
            >
            WhatsApp
        </a>
    </div>
</div>

<script>
    // Navbar scroll effect
    const navbar = document.getElementById("navbar");
    const navLogo = document.getElementById("navLogo");
    const navContainer = navbar?.querySelector(
        ".flex.items-center.justify-between",
    );

    window.addEventListener("scroll", () => {
        const currentScroll = window.pageYOffset;
        if (currentScroll > 50) {
            navbar?.classList.add("glass", "border-b");
            if (navbar) navbar.style.borderColor = "rgba(255,255,255,0.05)";
            navContainer?.classList.replace("h-32", "h-20");
            navLogo?.classList.replace("h-28", "h-14");
        } else {
            navbar?.classList.remove("glass", "border-b");
            if (navbar) navbar.style.borderColor = "transparent";
            navContainer?.classList.replace("h-20", "h-32");
            navLogo?.classList.replace("h-14", "h-28");
        }
    });

    // Mobile menu
    const menuBtn = document.getElementById("menuBtn");
    const mobileMenu = document.getElementById("mobileMenu");
    const closeMenuBtn = document.getElementById("closeMenu");
    const mobileLinks = document.querySelectorAll(".mobile-link");

    menuBtn?.addEventListener("click", () => {
        mobileMenu?.classList.add("open");
        menuBtn.setAttribute("aria-expanded", "true");
    });

    closeMenuBtn?.addEventListener("click", () => {
        mobileMenu?.classList.remove("open");
        menuBtn?.setAttribute("aria-expanded", "false");
    });

    mobileLinks.forEach((link) => {
        link.addEventListener("click", () => {
            mobileMenu?.classList.remove("open");
            menuBtn?.setAttribute("aria-expanded", "false");
        });
    });
</script>
