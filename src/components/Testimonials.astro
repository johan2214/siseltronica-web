---
const testimonials = [
    {
        name: "Carlos Rodriguez",
        role: "Gerente de Condominio",
        content: "La instalación del motor del portón fue rápida y profesional. El sistema de video portero ha mejorado mucho la seguridad de nuestro edificio. Altamente recomendados.",
        avatar: "CR"
    },
    {
        name: "Elena Martínez",
        role: "Dueña de Negocio",
        content: "Excelente asesoría técnica. Me ayudaron a elegir el sistema de cámaras perfecto para mi local. El acceso remoto funciona sin problemas desde mi celular.",
        avatar: "EM"
    },
    {
        name: "Ricardo Silva",
        role: "Ingeniero Civil",
        content: "He trabajado con Siseltronica en varios proyectos eléctricos. Su nivel de detalle y cumplimiento de normas técnicas es excelente. Son mi primera opción.",
        avatar: "RS"
    }
];
---

<section id="testimonios" class="py-24 bg-surface/30 relative overflow-hidden">
    <!-- Background glow - Static -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-brand-blue/5 rounded-full blur-[120px]"></div>
    <div class="absolute bottom-0 right-0 w-96 h-96 bg-brand-red/5 rounded-full blur-[100px]"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="text-center mb-16 fade-in">
            <span class="inline-block px-4 py-1.5 rounded-full border text-sm font-medium mb-4" style="background: rgba(239, 68, 68, 0.15); border-color: rgba(239, 68, 68, 0.3); color: #f87171;">Confianza y Calidad</span>
            <h2 class="text-4xl font-black mb-4">Lo que dicen nuestros <span class="gradient-text">Clientes</span></h2>
            <p class="text-gray-400 text-lg max-w-2xl mx-auto">La satisfacción de quienes confían en nosotros es nuestra mejor carta de presentación.</p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
            {testimonials.map((testi, index) => (
                <div class="fade-in" style={`transition-delay: ${index * 150}ms`}>
                    <div class="glass p-8 rounded-3xl border border-white/5 h-full flex flex-col">
                        <div class="flex items-center gap-4 mb-6">
                            <div class="w-14 h-14 rounded-full bg-gradient-to-br from-brand-blue to-brand-red flex items-center justify-center text-white font-bold text-lg">
                                {testi.avatar}
                            </div>
                            <div>
                                <h4 class="font-bold text-white">{testi.name}</h4>
                                <p class="text-xs text-gray-500">{testi.role}</p>
                            </div>
                        </div>
                        
                        <div class="mb-6">
                            <svg class="w-8 h-8 text-brand-blue/30 mb-4" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.437.917-4.004 3.638-4.004 5.849h3.999v10h-9.991z" />
                            </svg>
                            <p class="text-gray-300 italic leading-relaxed font-medium">"{testi.content}"</p>
                        </div>

                        <div class="mt-auto flex gap-1">
                            {[1,2,3,4,5].map(() => (
                                <svg class="w-4 h-4 text-yellow-500 fill-current" viewBox="0 0 20 20">
                                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                </svg>
                            ))}
                        </div>
                    </div>
                </div>
            ))}
        </div>
        <div class="line-glow mt-16"></div>
    </div>
</section>
