---
---
<section id="nosotros" class="py-24 relative overflow-hidden">
    <div class="absolute inset-0 bg-linear-to-b from-dark via-surface/20 to-dark"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
            <div class="fade-in relative z-10">
                <span class="inline-block px-4 py-1.5 rounded-full border text-sm font-medium mb-4" style="background: rgba(59, 130, 246, 0.15); border-color: rgba(59, 130, 246, 0.3); color: #60a5fa;">Sobre Nosotros</span>
                <h2 class="text-4xl sm:text-5xl font-black mb-6">Más de <span class="gradient-text">10 años</span> brindando soluciones</h2>
                <p class="text-gray-400 text-lg leading-relaxed mb-6">
                    <strong class="text-white">Siseltronica - Sistemas Eléctricos y Electrónicos C.A.</strong> es una empresa comprometida con la excelencia en el diseño, venta e instalación de sistemas eléctricos y electrónicos.
                </p>
                <p class="text-gray-400 text-lg leading-relaxed mb-8">
                    Nuestro equipo de técnicos certificados trabaja con las mejores marcas del mercado para garantizar la seguridad y eficiencia de cada proyecto. Desde hogares hasta grandes industrias, tenemos la solución que necesitas.
                </p>
                <div class="grid grid-cols-2 gap-6">
                    <div class="flex items-start gap-3">
                        <div class="w-10 h-10 rounded-lg flex items-center justify-center shrink-0 mt-1" style="background: rgba(59, 130, 246, 0.15);">
                            <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                        </div>
                        <div>
                            <h4 class="font-semibold text-white">Garantía Total</h4>
                            <p class="text-sm text-gray-400">Todos nuestros productos y servicios con garantía</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-3">
                        <div class="w-10 h-10 rounded-lg flex items-center justify-center shrink-0 mt-1" style="background: rgba(59, 130, 246, 0.15);">
                            <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                        </div>
                        <div>
                            <h4 class="font-semibold text-white">Soporte 24/7</h4>
                            <p class="text-sm text-gray-400">Asistencia técnica disponible cuando la necesites</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-3">
                        <div class="w-10 h-10 rounded-lg flex items-center justify-center shrink-0 mt-1" style="background: rgba(167, 14, 22, 0.15);">
                            <svg class="w-5 h-5 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                        </div>
                        <div>
                            <h4 class="font-semibold text-white">Marcas Premium</h4>
                            <p class="text-sm text-gray-400">Trabajamos con las mejores marcas del mercado</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-3">
                        <div class="w-10 h-10 rounded-lg flex items-center justify-center shrink-0 mt-1" style="background: rgba(167, 14, 22, 0.15);">
                            <svg class="w-5 h-5 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                        </div>
                        <div>
                            <h4 class="font-semibold text-white">Presupuesto Gratis</h4>
                            <p class="text-sm text-gray-400">Cotizaciones sin compromiso</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="relative fade-in">
                <div class="relative rounded-2xl overflow-hidden border" style="border-color: rgba(255,255,255,0.05);">
                    <div class="w-full h-80 flex items-center justify-center" style="background: linear-gradient(135deg, rgba(19,39,130,0.2), rgba(167,14,22,0.1));">
                        <svg class="w-48 h-48" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <circle cx="100" cy="100" r="80" stroke="#3b82f6" stroke-width="2" fill="rgba(19,39,130,0.05)" opacity="0.5"></circle>
                            <circle cx="100" cy="100" r="60" stroke="#ef4444" stroke-width="1.5" fill="rgba(167,14,22,0.05)" opacity="0.4"></circle>
                            <circle cx="100" cy="100" r="40" stroke="#3b82f6" stroke-width="1" fill="rgba(19,39,130,0.08)" opacity="0.3"></circle>
                            <circle cx="100" cy="100" r="5" fill="#3b82f6" opacity="0.6"></circle>
                            <line x1="100" y1="20" x2="100" y2="40" stroke="#3b82f6" stroke-width="1.5" opacity="0.3"></line>
                            <line x1="100" y1="160" x2="100" y2="180" stroke="#3b82f6" stroke-width="1.5" opacity="0.3"></line>
                            <line x1="20" y1="100" x2="40" y2="100" stroke="#ef4444" stroke-width="1.5" opacity="0.3"></line>
                            <line x1="160" y1="100" x2="180" y2="100" stroke="#ef4444" stroke-width="1.5" opacity="0.3"></line>
                        </svg>
                    </div>
                    <div class="absolute inset-0 bg-linear-to-t from-dark/60 via-transparent to-transparent"></div>
                </div>
                <div class="absolute -bottom-6 -left-6 p-6 rounded-2xl glass shadow-2xl">
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 rounded-xl flex items-center justify-center" style="background: rgba(37, 211, 102, 0.15);">
                            <svg class="w-6 h-6" style="color: #25d366;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        </div>
                        <div>
                            <div class="text-2xl font-black text-white">100%</div>
                            <div class="text-sm text-gray-400">Satisfacción</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="line-glow mt-16"></div>
    </div>
</section>
