---
interface Props {
    title: string;
    description: string;
    category: string;
    isNew?: boolean;
    isPopular?: boolean;
    isOffer?: boolean;
    isWiFi?: boolean;
    iconColor: 'blue' | 'red' | 'green' | 'yellow';
}

const { title, description, category, isNew, isPopular, isOffer, isWiFi, iconColor } = Astro.props;

const bgColors = {
    blue: 'background: color-mix(in srgb, var(--color-brand-blue), transparent 92%);',
    red: 'background: color-mix(in srgb, var(--color-brand-red), transparent 92%);',
    green: 'background: rgba(34, 197, 94, 0.06);',
    yellow: 'background: rgba(234, 179, 8, 0.06);'
};

const badgeColors = {
    blue: 'background: rgba(59, 130, 246, 0.2); color: #93c5fd; border: 1px solid rgba(59, 130, 246, 0.3);',
    red: 'background: rgba(239, 68, 68, 0.2); color: #fca5a5; border: 1px solid rgba(239, 68, 68, 0.3);',
    green: 'background: rgba(34, 197, 94, 0.2); color: #86efac; border: 1px solid rgba(34, 197, 94, 0.3);',
    yellow: 'background: rgba(234, 179, 8, 0.2); color: #fde047; border: 1px solid rgba(234, 179, 8, 0.3);'
};

const categoryLabels = {
    camaras: 'Cámaras',
    cctv: 'CCTV',
    portones: 'Portones',
    electricos: 'Eléctricos',
    intercom: 'Intercomunicadores',
    cables: 'Cables y Accesorios'
};

const categoryColors = {
    camaras: '#60a5fa',
    cctv: '#60a5fa',
    portones: '#4ade80',
    electricos: '#60a5fa',
    intercom: '#60a5fa',
    cables: '#f87171'
};

const whatsappText = `Hola! Me interesa la ${title}. ¿Podrían darme más información sobre precio y disponibilidad?`;
---
<div class="product-card visible-card rounded-2xl glass overflow-hidden card-hover fade-in relative" data-category={category}>
    <div class="relative h-56 flex items-center justify-center p-6" style={bgColors[iconColor]}>
        <slot name="icon" />
        
        {isNew && <span class="absolute top-4 left-4 px-3 py-1 rounded-full text-xs font-semibold" style={badgeColors.blue}>Nuevo</span>}
        {isPopular && <span class="absolute top-4 left-4 px-3 py-1 rounded-full text-xs font-semibold" style={badgeColors.red}>Popular</span>}
        {isOffer && <span class="absolute top-4 left-4 px-3 py-1 rounded-full text-xs font-semibold" style={badgeColors.yellow}>Oferta</span>}
        {isWiFi && <span class="absolute top-4 left-4 px-3 py-1 rounded-full text-xs font-semibold" style={badgeColors.blue}>WiFi</span>}
        {!isNew && !isPopular && !isOffer && !isWiFi && category === 'portones' && <span class="absolute top-4 left-4 px-3 py-1 rounded-full text-xs font-semibold" style={badgeColors.green}>Disponible</span>}
    </div>
    <div class="p-6">
        <span class="text-xs font-medium uppercase tracking-wider" style={`color: ${categoryColors[category as keyof typeof categoryColors] || '#4d88ff'}`}>{categoryLabels[category as keyof typeof categoryLabels]}</span>
        <h3 class="text-lg font-bold mt-1 mb-2">{title}</h3>
        <p class="text-zinc-300 text-sm mb-4">{description}</p>
        <div class="flex items-center justify-between">
            <span class="text-2xl font-black text-white">Consultar</span>
            <a href={`https://wa.me/4140779060?text=${encodeURIComponent(whatsappText)}`} target="_blank" class="whatsapp-btn flex items-center gap-2 px-4 py-2 bg-green-600 hover:bg-green-500 text-white text-sm font-semibold rounded-lg transition-all hover:scale-105 hover:shadow-lg hover:shadow-green-600/30">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"></path></svg>
                Consultar
            </a>
        </div>
    </div>
</div>
