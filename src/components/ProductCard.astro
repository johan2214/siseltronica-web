---
interface Props {
    id: string;
    title: string;
    shortDescription?: string;
    description: string;
    category: string;
    isNew?: boolean;
    isPopular?: boolean;
    isOffer?: boolean;
    isWiFi?: boolean;
    stockStatus?: 'instock' | 'outofstock' | 'onorder';
    iconColor: 'blue' | 'red' | 'green' | 'yellow' | string;
    image?: string;
}

const { id, title, shortDescription, description, category, isNew, isPopular, isOffer, isWiFi, stockStatus = 'instock', iconColor, image } = Astro.props;

const stockLabels = {
    instock: { text: 'En Stock', color: 'text-green-400 bg-green-400/10' },
    outofstock: { text: 'Agotado', color: 'text-red-400 bg-red-400/10' },
    onorder: { text: 'Bajo Pedido', color: 'text-yellow-400 bg-yellow-400/10' }
};

const bgColors = {
    blue: 'background: color-mix(in srgb, var(--color-brand-blue), transparent 92%);',
    red: 'background: color-mix(in srgb, var(--color-brand-red), transparent 92%);',
    green: 'background: rgba(34, 197, 94, 0.06);',
    yellow: 'background: rgba(234, 179, 8, 0.06);'
};

const badgeColors = {
    blue: 'background: rgba(59, 130, 246, 0.2); color: #93c5fd; border: 1px solid rgba(59, 130, 246, 0.3);',
    red: 'background: rgba(239, 68, 68, 0.2); color: #fca5a5; border: 1px solid rgba(239, 68, 68, 0.3);',
    green: 'background: rgba(34, 197, 94, 0.2); color: #86efac; border: 1px solid rgba(34, 197, 94, 0.3);',
    yellow: 'background: rgba(234, 179, 8, 0.2); color: #fde047; border: 1px solid rgba(234, 179, 8, 0.3);'
};

const categoryLabels: Record<string, string> = {
    camaras: 'Cámaras',
    cctv: 'CCTV',
    motores: 'Motores',
    tableros: 'Tableros',
    acceso: 'Control de Acceso',
    cables: 'Cables',
    ups: 'UPS'
};

const categoryColors: Record<string, string> = {
    camaras: '#60a5fa',
    cctv: '#60a5fa',
    motores: '#4ade80',
    tableros: '#60a5fa',
    acceso: '#60a5fa',
    cables: '#f87171',
    ups: '#60a5fa'
};

const productSlug = id.split('/').pop()?.replace('.json', '');
---
<div class="product-card visible-card rounded-2xl glass overflow-hidden card-hover fade-in relative group flex flex-col h-full" data-category={category}>
    <a href={`/productos/${productSlug}`} class="block relative h-56 overflow-hidden">
        {image ? (
            <img 
                src={image} 
                alt={title}
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                loading="lazy"
            />
        ) : (
            <div class="absolute inset-0 flex items-center justify-center" style={bgColors[iconColor]}>
                <div class="h-28 w-28 flex items-center justify-center transition-transform duration-500 group-hover:scale-110">
                    <slot name="icon" />
                </div>
            </div>
        )}
        
        <div class="absolute inset-0 bg-linear-to-t from-dark/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-4">
            <span class="text-white text-xs font-bold uppercase tracking-widest">Ver Detalles</span>
        </div>

        {isNew && <span class="absolute top-4 left-4 px-3 py-1 rounded-full text-xs font-semibold z-10" style={badgeColors.blue}>Nuevo</span>}
        {isPopular && <span class="absolute top-4 left-4 px-3 py-1 rounded-full text-xs font-semibold z-10" style={badgeColors.red}>Popular</span>}
        {isOffer && <span class="absolute top-4 left-4 px-3 py-1 rounded-full text-xs font-semibold z-10" style={badgeColors.yellow}>Oferta</span>}
        {isWiFi && <span class="absolute top-4 left-4 px-3 py-1 rounded-full text-xs font-semibold z-10" style={badgeColors.blue}>WiFi</span>}
    </a>
    <div class="p-6 flex flex-col flex-1">
        <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-medium uppercase tracking-wider" style={`color: ${categoryColors[category] || '#4d88ff'}`}>{categoryLabels[category] || category}</span>
            <span class={`text-[10px] px-2 py-0.5 rounded-full font-bold uppercase tracking-tighter ${stockLabels[stockStatus as keyof typeof stockLabels].color}`}>
                {stockLabels[stockStatus as keyof typeof stockLabels].text}
            </span>
        </div>
        <h3 class="text-lg font-bold mb-2">
            <a href={`/productos/${productSlug}`} class="hover:text-brand-blue-light transition-colors line-clamp-1">{title}</a>
        </h3>
        <p class="text-gray-400 text-sm mb-6 line-clamp-3">
            {shortDescription || description}
        </p>
        <div class="mt-auto flex flex-col gap-3">
            <div class="flex items-center justify-between">
                <span class="text-xl font-black text-white">Consultar</span>
                <a href={`/productos/${productSlug}`} class="px-4 py-2 border border-white/10 hover:border-brand-blue-light/50 hover:text-brand-blue-light text-white text-sm font-semibold rounded-lg transition-all">
                    Detalles
                </a>
            </div>
            <button 
                class="add-quote-btn w-full py-2.5 bg-white/5 hover:bg-white/10 border border-white/10 rounded-lg text-[10px] font-bold uppercase tracking-widest transition-all flex items-center justify-center gap-2 group"
                data-product={JSON.stringify({ id, title, image, category: categoryLabels[category] || category })}
            >
                <svg class="w-4 h-4 text-brand-blue-light group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                Añadir a Cotización
            </button>
        </div>
    </div>
</div>

<script>
    function setupQuoteButtons() {
        document.querySelectorAll('.add-quote-btn').forEach(btn => {
            if (btn.getAttribute('data-listened')) return;
            btn.addEventListener('click', (e) => {
                const product = JSON.parse((e.currentTarget as HTMLElement).dataset.product!);
                window.dispatchEvent(new CustomEvent('add-to-quote', { detail: product }));
            });
            btn.setAttribute('data-listened', 'true');
        });
    }

    setupQuoteButtons();
    // Re-run on dynamic updates (like filters)
    document.addEventListener('astro:page-load', setupQuoteButtons);
    // Observe DOM changes for the grid
    const observer = new MutationObserver(setupQuoteButtons);
    const grid = document.getElementById('productGrid');
    if (grid) observer.observe(grid, { childList: true });
</script>
