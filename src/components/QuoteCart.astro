---
---

<div id="quote-cart-trigger" class="fixed bottom-24 right-8 z-50 hidden">
    <button class="relative p-4 bg-brand-blue text-white rounded-full shadow-2xl hover:scale-110 transition-all group">
        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path></svg>
        <span id="cart-count" class="absolute -top-1 -right-1 w-6 h-6 bg-red-600 text-white text-[10px] font-bold flex items-center justify-center rounded-full border-2 border-dark">0</span>
    </button>
</div>

<!-- Cart Modal -->
<div id="quote-cart-modal" class="fixed inset-0 z-[60] hidden">
    <div class="absolute inset-0 bg-dark/80 backdrop-blur-sm" id="cart-overlay"></div>
    <div class="absolute right-0 top-0 h-full w-full max-w-md bg-surface border-l border-white/10 shadow-2xl p-8 flex flex-col translate-x-full transition-transform duration-300" id="cart-panel">
        <div class="flex items-center justify-between mb-8">
            <h2 class="text-2xl font-black">Mi <span class="gradient-text">Cotización</span></h2>
            <button id="close-cart" class="p-2 hover:bg-white/5 rounded-lg text-gray-400">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>

        <div id="cart-items" class="flex-1 overflow-y-auto space-y-4 pr-2 custom-scrollbar">
            <!-- Items injected by JS -->
        </div>

        <div class="mt-8 pt-8 border-t border-white/10">
            <button id="send-quote" class="w-full py-4 bg-green-600 hover:bg-green-500 text-white font-black rounded-2xl transition-all flex items-center justify-center gap-3">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"></path></svg>
                Solicitar Cotización por WhatsApp
            </button>
        </div>
    </div>
</div>

<script>
    let cart = JSON.parse(localStorage.getItem('quote_cart') || '[]');
    
    const trigger = document.getElementById('quote-cart-trigger');
    const modal = document.getElementById('quote-cart-modal');
    const cartPanel = document.getElementById('cart-panel');
    const closeBtn = document.getElementById('close-cart');
    const overlay = document.getElementById('cart-overlay');
    const countLabel = document.getElementById('cart-count');
    const itemsContainer = document.getElementById('cart-items');
    const sendBtn = document.getElementById('send-quote');

    function updateCartUI() {
        if (cart.length > 0) {
            trigger?.classList.remove('hidden');
            countLabel!.textContent = cart.length.toString();
        } else {
            trigger?.classList.add('hidden');
        }

        itemsContainer!.innerHTML = cart.length > 0 
            ? cart.map((item: any, index: number) => `
                <div class="glass p-4 rounded-xl border border-white/5 flex items-center gap-4">
                    <img src="${item.image}" class="w-16 h-16 object-cover rounded-lg border border-white/10" />
                    <div class="flex-1">
                        <h4 class="text-sm font-bold text-white line-clamp-1">${item.title}</h4>
                        <p class="text-[10px] text-gray-500 uppercase">${item.category}</p>
                    </div>
                    <button class="remove-item p-2 text-gray-500 hover:text-red-500" data-index="${index}">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                    </button>
                </div>
            `).join('')
            : '<div class="text-center py-12 text-gray-500">No hay productos en tu lista</div>';

        document.querySelectorAll('.remove-item').forEach(btn => {
            btn.addEventListener('click', (e) => {
                const index = parseInt((e.currentTarget as HTMLElement).dataset.index!);
                cart.splice(index, 1);
                localStorage.setItem('quote_cart', JSON.stringify(cart));
                updateCartUI();
            });
        });
    }

    trigger?.addEventListener('click', () => {
        modal?.classList.remove('hidden');
        setTimeout(() => cartPanel?.classList.remove('translate-x-full'), 10);
    });

    const closeCart = () => {
        cartPanel?.classList.add('translate-x-full');
        setTimeout(() => modal?.classList.add('hidden'), 300);
    };

    closeBtn?.addEventListener('click', closeCart);
    overlay?.addEventListener('click', closeCart);

    window.addEventListener('add-to-quote', (e: any) => {
        const product = e.detail;
        if (!cart.find((item: any) => item.id === product.id)) {
            cart.push(product);
            localStorage.setItem('quote_cart', JSON.stringify(cart));
            updateCartUI();
            
            // Animation
            trigger?.classList.add('scale-125');
            setTimeout(() => trigger?.classList.remove('scale-125'), 300);
        }
    });

    sendBtn?.addEventListener('click', () => {
        const text = `Hola Siseltronica! Me gustaría solicitar una cotización para los siguientes equipos:\n\n` + 
            cart.map((item: any) => `- ${item.title} (ID: ${item.id})`).join('\n') +
            `\n\n¿Podrían darme precios y disponibilidad? Gracias!`;
        
        window.open(`https://wa.me/4140779060?text=${encodeURIComponent(text)}`, '_blank');
    });

    updateCartUI();
</script>

<style>
    .translate-x-full { transform: translateX(100%); }
    .custom-scrollbar::-webkit-scrollbar { width: 4px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: rgba(255,255,255,0.02); }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(59, 130, 246, 0.2); border-radius: 10px; }
</style>
