{
  "name": "bustling-bar",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --max-old-space-size=4096 ./node_modules/astro/bin/astro.mjs dev",
    "build": "node --max-old-space-size=4096 ./node_modules/astro/bin/astro.mjs build",
    "preview": "astro preview",
    "clean": "powershell -Command \"Remove-Item -Path .astro, dist -Recurse -Force -ErrorAction SilentlyContinue\"",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/netlify": "^7.0.8",
    "@astrojs/vercel": "^11.0.10",
    "@supabase/supabase-js": "^2.105.4",
    "@tailwindcss/vite": "^4.2.4",
    "astro": "^7.3.2",
    "tailwindcss": "^4.2.4"
  }
}
